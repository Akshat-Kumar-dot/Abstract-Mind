{
  "manifest_version": 3,
  "name": "Abstract Mind Form Filler",
  "version": "0.1.0",
  "description": "Types the details Abstract Mind read from your manuscript or UPI receipt into the form you have open. You review and submit.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Fill this form with Abstract Mind",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" }
  },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["http://localhost/*", "http://127.0.0.1/*", "https://*.onrender.com/*"],
  "optional_host_permissions": ["https://*/*"]
}
