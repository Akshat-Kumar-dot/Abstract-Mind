# Copy to .env for local runs. On Render, set these under Environment instead.

# Which LLM fills gaps the rules leave in a paper's header:
# auto (Gemini if its key is set, else Groq), gemini, groq, or none
LLM_PROVIDER=auto

# Gemini key from Google AI Studio. For unpublished papers use a paid key:
# Google's terms allow free-tier prompts to be used to improve its products.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Groq key from console.groq.com
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Model names change; check each provider's current model list if a call fails.
LLM_TIMEOUT=30
MAX_UPLOAD_MB=20

# Where accounts and saved (encrypted) documents are stored.
# Production: a Postgres URL, e.g. from Neon, Supabase or Render Postgres:
#   DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# Leave it empty to use a local SQLite file instead (DB_PATH, default data/abstract_mind.db).
DATABASE_URL=
DB_PATH=

# "Continue with Google". Create an OAuth client in Google Cloud Console
# (APIs & Services > Credentials > Create credentials > OAuth client ID > Web application)
# and add this Authorized redirect URI:
#   http://localhost:8765/api/v1/auth/google/callback          (local)
#   https://<your-domain>/api/v1/auth/google/callback          (production; also set PUBLIC_ORIGIN)
# The Google button stays hidden until both are set.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
